@@ -27,10 +193,15 @@ class _State:
 
 
 def build(header, prototype):
-    return _build_function_definition(prototype, header)
+    keys = _index_provenance(prototype) if SYMBOLIZE_UPVALUES else None
+    node = _build_function_definition(prototype, header, keys)
+    if keys is not None:
+        node._uv_keys = keys          # 供 writer/main 生成 UV-MAP 头部注释
+        node._uv_map_text = render_uv_map(prototype, keys)
+    return node
 
 
-def _build_function_definition(prototype, header):
+def _build_function_definition(prototype, header, uv_keys=None):
     node = nodes.FunctionDefinition()
 
     state = _State()
@@ -38,6 +209,8 @@ def _build_function_definition(prototype, header):
     state.constants = prototype.constants
     state.debuginfo = prototype.debuginfo
     state.header = header
+    state.proto_path = _PROTO_PATH.get(id(prototype), '0')
+    state.uv_keys = uv_keys
 
     node._upvalues = prototype.constants.upvalue_references
     node._debuginfo = prototype.debuginfo
@@ -870,7 +1043,7 @@ def _build_function(state, slot):
     prototype = state.constants.complex_constants[slot]
 
     try:
-        return _build_function_definition(prototype, state.header)
+        return _build_function_definition(prototype, state.header, getattr(state, 'uv_keys', None))
     except Exception as err:
         if not handle_invalid_functions:
             raise err
@@ -1006,6 +1179,11 @@ def _build_identifier(state, addr, slot, want_type):
     if want_type == nodes.Identifier.T_UPVALUE:
         name = state.debuginfo.lookup_upvalue_name(slot)
 
+        # 无 debug 名时（本项目全部文件都 stripped）改用具名化符号，
+        # 保证「同源同名、异源异名」；否则 writer 会输出 uv0/uv1/uv2 伪名。
+        if not name and SYMBOLIZE_UPVALUES:
+            name = _symbol_for(getattr(state, 'uv_keys', None), getattr(state, 'proto_path', '0'), slot)
+
         # No problem if name is None, that'll be fixed in writer.Visitor.visit_identifier
         node.name = name
         node.type = want_type
