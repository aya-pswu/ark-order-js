--- a/tools/ljd/ljd/ast/builder.py
+++ b/tools/ljd/ljd/ast/builder.py
@@ -10,6 +10,171 @@ from ljd.bytecode.helpers import get_jump_destination
 
 handle_invalid_functions = False
 
+# ---- upvalue provenance 具名化（本项目补丁，见 工作指南 A1/B1）----------------
+# 背景：字节码被 strip（实测 3491/3491 文件 is_stripped），upvalue 真名永久不可恢复；
+# ljd 只能输出 per-proto 编号 uv0/uv1/uv2，跨闭包不可比，照抄必崩（149/174/180 三踩）。
+# 解法：不猜名字，改输出**唯一来源符号**。每个 upvalue 的引用链可精确解析到
+#       「父 proto 的栈槽」(instack=1) 或继续上溯到 chunk 层，得到键 slot:<path>:<idx>。
+#       同键 ⇒ 必然同一变量；异键 ⇒ 必然不同变量。
+SYMBOLIZE_UPVALUES = False
+_PROTO_PATH = {}     # id(proto)  -> path（'0_4_2' 形式）
+_UV_KEYS = {}        # (path, uv) -> 'slot:<owner_path>:<slot>'（仅调试/兼容用）
+
+_UV_INSTACK = 0x8000
+_UV_IDXMASK = 0x3FFF
+
+
+def _child_protos(proto):
+    return [c for c in (proto.constants.complex_constants or [])
+            if hasattr(c, 'instructions')]
+
+
+def _walk_protos(root, path='0'):
+    yield root, path
+    for i, c in enumerate(_child_protos(root)):
+        for item in _walk_protos(c, '%s_%d' % (path, i)):
+            yield item
+
+
+def _index_provenance(root):
+    """返回 {(path, uv): 'slot:<owner>:<slot>'}。逐文件独立，避免多线程批处理串味。"""
+    _PROTO_PATH.clear()
+    _UV_KEYS.clear()
+    pm = {}
+    for proto, path in _walk_protos(root):
+        _PROTO_PATH[id(proto)] = path
+        pm[path] = proto
+
+    def resolve(path, idx, depth=0):
+        if depth > 64:
+            return 'cycle'
+        refs = pm[path].constants.upvalue_references
+        if idx >= len(refs):
+            return 'oob'
+        ref = refs[idx]
+        si = ref & _UV_IDXMASK
+        parent = path.rsplit('_', 1)[0] if '_' in path else None
+        if parent is None:
+            return 'chunk:%d' % si           # 顶层 chunk 的 upvalue（_ENV 等）
+        if ref & _UV_INSTACK:
+            return 'slot:%s:%d' % (parent, si)
+        return resolve(parent, si, depth + 1)
+
+    keys = {}
+    for path, proto in pm.items():
+        for i in range(len(proto.constants.upvalue_references)):
+            keys[(path, i)] = resolve(path, i)
+    _UV_KEYS.update(keys)
+    return keys
+
+
+def _symbol_for(keys, path, idx):
+    key = keys.get((path, idx)) if keys else None
+    if not key or not key.startswith('slot:'):
+        return None
+    _, owner, slot = key.split(':')
+    return 'u%s_%s' % (owner, slot)
+
+
+def _insn_name(ins):
+    return getattr(ins, 'name', '?')
+
+
+def _children_of(proto):
+    return [c for c in (proto.constants.complex_constants or []) if hasattr(c, 'instructions')]
+
+
+def _owner_funcs(proto):
+    """父 proto 中 FNEW 某 child 后紧跟的 GSET/TSETS 常量名 = 该闭包被赋给的字段名。"""
+    kids = {id(k): i for i, k in enumerate(_children_of(proto))}
+    cc = proto.constants.complex_constants or []
+    names = {}
+    ins = proto.instructions
+    for i, it in enumerate(ins):
+        if _insn_name(it) != 'FNEW':
+            continue
+        cidx, a = getattr(it, 'CD', None), getattr(it, 'A', None)
+        if cidx is None or cidx >= len(cc) or id(cc[cidx]) not in kids:
+            continue
+        for j in range(i + 1, min(i + 4, len(ins))):
+            nxt = ins[j]
+            if getattr(nxt, 'A', None) != a:
+                break
+            if _insn_name(nxt) in ('GSET', 'GSETV', 'TSETS', 'TSETV'):
+                ck = getattr(nxt, 'CD', -1)
+                if ck < len(cc) and isinstance(cc[ck], str):
+                    names[kids[id(cc[cidx])]] = cc[ck]
+                break
+    return names
+
+
+def _func_chain(pm, path):
+    names, cur = [], '0'
+    for seg in path.split('_')[1:]:
+        nm = _owner_funcs(pm[cur]).get(int(seg))
+        names.append(nm or '匿名闭包#%s' % seg)
+        cur += '_' + seg
+    return '.'.join(names) if names else '<chunk>'
+
+
+def _slot_role(owner, slot):
+    """给来源槽位一个可读角色 + 最强初始化证据（表构造优先，其次数/标志，最后取全局）。"""
+    if slot < owner.arguments_count:
+        return ('参数%d' % slot) + ('(self)' if slot == 0 else ''), 'ARG'
+    best = None
+    rank = {'TNEW': 4, 'TDUP': 4, 'KSHORT': 3, 'KPRI': 3, 'KNUM': 3, 'GGET': 2}
+    for i, it in enumerate(owner.instructions):
+        if getattr(it, 'A', None) != slot:
+            continue
+        nm = _insn_name(it)
+        r = rank.get(nm, 0)
+        if r and (best is None or r > best[0]):
+            best = (r, nm, i)
+    if best is None:
+        return '局部', ''
+    r, nm, i = best
+    label = {'TNEW': '局部表', 'TDUP': '局部表', 'KSHORT': '局部数/标志',
+             'KPRI': '局部数/标志', 'KNUM': '局部数/标志', 'GGET': '局部(取全局)'}[nm]
+    return label, '@%d %s' % (i, nm)
+
+
+def render_uv_map(root, keys, limit=60):
+    """生成头部注释：符号 → 来源函数 + 角色 + 证据。"""
+    pm = {path: proto for proto, path in _walk_protos(root)}
+    groups = {}
+    for (path, uv), key in keys.items():
+        if not key.startswith('slot:'):
+            continue
+        _, owner, slot = key.split(':')
+        sym = 'u%s_%s' % (owner, slot)
+        groups.setdefault(sym, {'owner': owner, 'slot': int(slot), 'refs': set()})
+        groups[sym]['refs'].add(path)
+
+    if not groups:
+        return ''
+
+    out = ['-- ==== LJD UV SYMBOLS（provenance 唯一化，本项目补丁）====',
+           '-- 本文件不含 uv0/uv1/uv2 伪名。每个符号 = 一个确定的捕获变量：',
+           '--   u<父proto路径>_<栈槽>  ⇒  同符号必然同源，异符号必然异源。',
+           '-- 改写本文件时请保留符号作绑定，例如： local self = u0_4_0',
+           '-- ' + '-' * 64]
+    for sym in sorted(groups, key=lambda s: (len(s), s)):
+        g = groups[sym]
+        owner = pm.get(g['owner'])
+        if owner is None:
+            continue
+        role, ev = _slot_role(owner, g['slot'])
+        chain = _func_chain(pm, g['owner'])
+        refs = len(g['refs'])
+        out.append('--   %-14s %s 的 %s%s   [引用 %d 处]' % (
+            sym, chain, role, (' ' + ev) if ev else '', refs))
+        if len(out) > limit:
+            out.append('--   ...（更多符号见文件内引用）')
+            break
+    out.append('-- ' + '=' * 64)
+    return '\n'.join(out) + '\n'
+
+
 
 class _State:
     def __init__(self):
@@ -19,6 +184,7 @@ class _State:
         self.blocks = []
         self.block_starts = {}
         self.header = None
+        self.proto_path = '0'
 
